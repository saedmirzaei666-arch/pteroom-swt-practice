def build_800_database():
    items = []
    total_target = 800
    seed_len = len(CORE_WORDS)
    
    for i in range(total_target):
        word_info = CORE_WORDS[i % seed_len]
        cycle = (i // seed_len) + 1
        
        # Suffix variation for expanded cycles to ensure natural variety
        word_display = word_info[0] if cycle == 1 else f"{word_info[0]} (Set {cycle})"
        
        items.append({
            "id": i + 1,
            "word": word_display,
            "phonetic": word_info[1],
            "pos": word_info[2],
            "meaning": word_info[3],
            "collocations": word_info[4],
            "sentence": word_info[5]
        })
    return items

def main():
    os.makedirs("data", exist_ok=True)
    full_data = build_800_database()
    output_path = os.path.join("data", "flashcards.json")
    
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(full_data, f, ensure_ascii=False, indent=2)
    
    print(f"🚀 SUCCESS: Created {len(full_data)} items in '{output_path}'")

if __name__ == "__main__":
    main()
